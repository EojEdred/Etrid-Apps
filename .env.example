# Etrid Apps Environment Configuration
# Copy this file to .env.local and fill in values

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Primearc Core Chain RPC
NEXT_PUBLIC_PRIMEARC_RPC_URL=wss://rpc.etrid.network
NEXT_PUBLIC_PRIMEARC_HTTP_URL=https://rpc.etrid.network

# Chain IDs
NEXT_PUBLIC_PRIMEARC_CHAIN_ID=etrid
NEXT_PUBLIC_ETH_PBC_CHAIN_ID=1001

# =============================================================================
# API ENDPOINTS
# =============================================================================

# Wallet API
NEXT_PUBLIC_WALLET_API_URL=https://api.etrid.network/wallet

# Governance API (Snapshot)
NEXT_PUBLIC_SNAPSHOT_HUB_URL=https://hub.snapshot.org
NEXT_PUBLIC_SNAPSHOT_SPACE=etrid.eth

# Bridge API
NEXT_PUBLIC_BRIDGE_API_URL=https://bridge.etrid.network/api

# =============================================================================
# MONITORING
# =============================================================================

# Prometheus/Grafana
NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3000

# Telemetry
NEXT_PUBLIC_TELEMETRY_URL=wss://telemetry.etrid.network/feed

# =============================================================================
# WALLET CONNECT
# =============================================================================

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# =============================================================================
# ANALYTICS (Optional)
# =============================================================================

NEXT_PUBLIC_ANALYTICS_ID=
